{
  "name": "torob-inperson-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "data:audit": "node --env-file-if-exists=.env.local --import tsx scripts/audit-dataset.ts",
    "data:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-dataset.ts",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-test.ts",
    "embeddings:index": "node --env-file=.env.local --import tsx scripts/index-embeddings.ts",
    "contact:worker": "node --env-file-if-exists=.env.local --import tsx scripts/contact-worker.ts",
    "release:check": "python3 scripts/package-release.py --check",
    "release:source": "python3 scripts/package-release.py",
    "dev:optimized": "node scripts/run-profile.mjs optimized dev",
    "dev:boxapi": "node scripts/run-profile.mjs boxapi dev",
    "build:optimized": "node scripts/run-profile.mjs optimized build",
    "build:boxapi": "node scripts/run-profile.mjs boxapi build",
    "start:optimized": "node scripts/run-profile.mjs optimized start",
    "start:boxapi": "node scripts/run-profile.mjs boxapi start",
    "ai:check": "node scripts/run-profile.mjs boxapi check-ai",
    "release:optimized": "python3 scripts/package-release.py --edition optimized --output releases/torobchat-optimized-source.zip",
    "release:boxapi": "python3 scripts/package-release.py --edition boxapi --output releases/torobchat-boxapi-source.zip"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.4.2",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
