# Local uses PostgreSQL via PGlite. Production: managed PostgreSQL connection string.
DATABASE_URL=
PGLITE_PATH=./data/db
AI_API_KEY=
AI_PROVIDER=boxapi
AI_BASE_URL=https://ai.boxapi.ir/ai/v1
AI_MODEL=gpt-6-luna
AI_MAX_REQUESTS_PER_TURN=3
AI_MAX_TOOL_CALLS=6
AI_MAX_OUTPUT_TOKENS=800
AI_DAILY_REQUEST_LIMIT=100
AI_TIMEOUT_MS=30000
DEMO_CONTACT_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=
# Optional local isolation; leave .next for Docker/Liara defaults.
NEXT_BUILD_DIR=

# BoxAPI embeddings need a vector model, not gpt-6-luna (chat).
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://ai.boxapi.ir/ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_DAILY_REQUEST_LIMIT=100
EMBEDDING_DAILY_INPUT_LIMIT=200000
EMBEDDING_TIMEOUT_MS=8000
EMBEDDING_TOP_K=24
EMBEDDING_MIN_SIMILARITY=0.25

# Server-only Neshan routing. Never use a NEXT_PUBLIC key.
NESHAN_API_KEY=
NESHAN_DAILY_REQUEST_LIMIT=100
NESHAN_WALKING_API_VERSION=v4

# Live contact is disabled. Simulation sends nothing and costs zero.
CONTACT_REAL_MODE=false
CONTACT_GATEWAY_URL=
CONTACT_GATEWAY_TOKEN=
CONTACT_CALLBACK_SECRET=
CONTACT_REGISTRY_PATH=
CONTACT_VOICE_MAX_COST_TOMAN=
CONTACT_SMS_MAX_COST_TOMAN=
CONTACT_DAILY_MAX_COST_TOMAN=0
CONTACT_DAILY_MAX_JOBS=100
